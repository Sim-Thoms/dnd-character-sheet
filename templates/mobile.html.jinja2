<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
<title>{{ character_data.identity.name }}</title>
<style>
  @font-face {
    font-family: 'Flavia';
    src: url(data:font/ttf;base64,) format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  :root {
    --accent: {{ character_data.identity.accent_color }};
    --expertise: #adff2f;
    --bg: #0a0a0a;
    --surface: #1a1a1a;
    --border: #2e2e2e;
    --text: #ffffff;
    --text-secondary: #b3b3b3;
    --text-muted: #7a7a7a;
    --radius: 8px;
    --font-sans: 'Flavia', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Courier New", monospace;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 16px 12px 24px;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  .sheet {
    max-width: 420px;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px 16px 80px;
  }
  h1 { font-size: 20px; font-weight: 600; margin: 0; display: inline; letter-spacing: 0.01em; }
  .subtitle { font-size: 13px; color: var(--text-secondary); margin: 3px 0 16px; }
  .badge {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 2px 8px;
    border-radius: var(--radius);
    margin-left: 8px;
    vertical-align: middle;
  }
  .section-label {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 2px;
    border-bottom: 1px solid var(--border);
    font-size: 13.5px;
  }
  .row:last-child { border-bottom: none; }
  .row-list { border-top: 1px solid var(--border); margin-bottom: 16px; }
  .mono { font-family: var(--font-mono); }
  .accent { color: var(--accent); }
  .expertise { color: var(--expertise); }
  .muted { color: var(--text-muted); }
  .secondary { color: var(--text-secondary); }
  .metric-row { display: flex; margin-bottom: 16px; }
  .metric { flex: 1; text-align: center; }
  .metric-divider { width: 1px; background: var(--border); }
  .metric-label { font-size: 11px; color: var(--text-muted); margin: 0 0 2px; }
  .metric-value { font-family: var(--font-mono); font-size: 17px; font-weight: 600; margin: 0; }
  .hp-block {
    display: flex; align-items: center; gap: 10px;
    background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 10px 12px; margin-bottom: 16px;
  }
  .hp-btn {
    width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border);
    background: var(--surface); font-size: 16px; line-height: 1; cursor: pointer; flex-shrink: 0;
    color: var(--text);
  }
  .hp-btn:active { background: var(--bg); }
  .hp-bar-track { height: 5px; background: var(--border); border-radius: 3px; overflow: hidden; margin-top: 4px; }
  .hp-bar-fill { height: 100%; background: var(--accent); transition: width 0.15s ease; }
  .weapon-card {
    border: 1px solid var(--border); border-radius: var(--radius);
    padding: 9px 12px; margin-bottom: 8px;
  }
  .weapon-card:last-child { margin-bottom: 16px; }
  .weapon-top { display: flex; justify-content: space-between; font-size: 13.5px; }
  .weapon-name { font-weight: 600; }
  .weapon-sub { font-size: 12px; color: var(--text-secondary); margin: 2px 0 0; }
  .empty-state { font-size: 13px; color: var(--text-muted); padding: 6px 2px 16px; }
  .slot-row { display: flex; align-items: center; gap: 8px; padding: 4px 0; }
  .slot-label { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); width: 36px; flex-shrink: 0; }
  .slot-counter-row { display: flex; align-items: center; gap: 10px; padding: 5px 0; }
  .slot-current-max { flex: 1; text-align: center; font-size: 13.5px; }
  .death-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .death-dots { display: flex; gap: 8px; }
  .death-dot { width: 16px; height: 16px; border-radius: 50%; border: 1px solid var(--border); display: inline-block; }
  .death-dot.filled-success { background: var(--text); border-color: var(--text); }
  .death-dot.filled-failure { background: #c0392b; border-color: #c0392b; }
  #death-reset {
    margin-top: 2px; margin-bottom: 16px; background: none; border: 1px solid var(--border);
    color: var(--text-muted); border-radius: var(--radius); padding: 5px 10px; font-size: 12px;
    font-family: var(--font-sans); cursor: pointer;
  }
  .disclosure {
    padding: 9px 2px; border-bottom: 1px solid var(--border); cursor: pointer;
  }
  .row-list .disclosure:last-child { border-bottom: none; }
  .disclosure-head { display: flex; justify-content: space-between; align-items: center; }
  .disclosure-title { font-size: 13.5px; }
  .disclosure-body {
    font-size: 12.5px; color: var(--text-secondary); margin: 6px 0 0; display: none;
    line-height: 1.5; text-align: justify; -webkit-hyphens: auto; hyphens: auto;
  }
  .disclosure-body p { margin: 0 0 10px; }
  .disclosure-body p:last-child { margin-bottom: 0; }
  .disclosure.open .disclosure-body { display: block; }
  .disclosure.open .chev { transform: rotate(180deg); }
  .chev { transition: transform 0.15s ease; color: var(--text-muted); flex-shrink: 0; }
  .disclosure-title.prepared::before { content: "\2022  "; color: var(--accent); }
  .disclosure-title.unprepared { color: var(--text-muted); }
  nav {
    display: flex; justify-content: space-around;
    position: fixed; bottom: 0; left: 0; right: 0;
    max-width: 420px; margin: 0 auto;
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 4px 0 max(4px, env(safe-area-inset-bottom));
    z-index: 10;
  }
  .nav-btn {
    background: none; border: none; cursor: pointer;
    width: 48px; height: 48px; padding: 6px 0 4px;
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    color: var(--text-muted);
  }
  .nav-btn.active { color: var(--accent); }
  .nav-btn svg { width: 20px; height: 20px; }
  .nav-dot { width: 4px; height: 4px; border-radius: 50%; background: transparent; }
  .nav-btn.active .nav-dot { background: var(--accent); }
  section[data-page] { display: none; }
  section[data-page].active { display: block; }
</style>
</head>
<body>

<div class="sheet">

  <!-- ================= PAGE 0: OVERVIEW ================= -->
  <section data-page="0">
    <h1>{{ character_data.identity.name }}</h1><span class="badge">Lv {{ character_data.identity.level }}</span>
    <p class="subtitle">{{ character_data.identity.race }} &ndash; {{ character_data.identity.class }} ({{ character_data.identity.subclass }})</p>

    <div class="hp-block">
      <button class="hp-btn" id="hp-minus" aria-label="Decrease current hit points">&minus;</button>
      <div style="flex:1;">
        <div class="row" style="border:none;padding:0;font-family:var(--font-mono);font-size:12px;color:var(--text-secondary);">
          <span>Hp</span><span id="hp-val">{{ character_data.combat.hp.maximum_hp }}</span><span>{{ character_data.combat.hp.maximum_hp }}</span>
        </div>
        <div class="hp-bar-track"><div class="hp-bar-fill" id="hp-bar" style="width:100%;"></div></div>
      </div>
      <button class="hp-btn" id="hp-plus" aria-label="Increase current hit points">+</button>
    </div>

    <div class="metric-row">
      <div class="metric">
        <p class="metric-label">Hit dice</p>
        <p class="metric-value">{{ character_data.identity.level }}/{{ character_data.identity.level }} {{ character_data.combat.hp.hit_dice }}</p>
      </div>
      <div class="metric-divider"></div>
      <div class="metric">
        <p class="metric-label">Speed</p>
        <p class="metric-value">{{ character_data.combat.speed }}ft</p>
      </div>
      <div class="metric-divider"></div>
      <div class="metric">
        <p class="metric-label">Prof. bonus</p>
        <p class="metric-value">[{{ "%+d"|format(character_data.identity.proficiency_bonus) }}]</p>
      </div>
    </div>

    <p class="section-label">Saving throws</p>
    <div class="row-list">
      {% for ability, bonus in character_data.ability.saving_throw.items() %}
      <div class="row">
        <span class="secondary">{{ ability_abbreviations[ability] }}</span>
        <span class="mono secondary">{{ "%+d"|format(bonus) }}</span>
      </div>
      {% endfor %}
    </div>

    {% set features = character_data.features_and_traits | selectattr("name") | selectattr("label", "equalto", "feature") | list | sort(attribute="name") %}
    {% set traits = character_data.features_and_traits | selectattr("name") | selectattr("label", "equalto", "trait") | list | sort(attribute="name") %}

    <p class="section-label">Features</p>
    <div class="row-list">
      {% for f in features %}
      <div class="disclosure" data-toggle>
        <div class="disclosure-head">
          <span class="disclosure-title">{{ f.name }}</span>
          <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        <div class="disclosure-body">
          {% for para in f.description | paragraphs %}
          <p>{{ para }}</p>
          {% endfor %}
        </div>
      </div>
      {% else %}
      <p class="empty-state">No features recorded.</p>
      {% endfor %}
    </div>

    <p class="section-label">Traits</p>
    <div class="row-list">
      {% for t in traits %}
      <div class="disclosure" data-toggle>
        <div class="disclosure-head">
          <span class="disclosure-title">{{ t.name }}</span>
          <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        <div class="disclosure-body">
          {% for para in t.description | paragraphs %}
          <p>{{ para }}</p>
          {% endfor %}
        </div>
      </div>
      {% else %}
      <p class="empty-state">No traits recorded.</p>
      {% endfor %}
    </div>
  </section>

  <!-- ================= PAGE 1: ABILITIES & SKILLS ================= -->
  <section data-page="1">
    <h1 style="font-size:16px;display:block;margin-bottom:12px;">Abilities and skills</h1>

    <div class="row-list">
      {% for ability, score in character_data.ability.ability_scores.items() %}
      <div class="row">
        <span>{{ ability | capitalize }}</span>
        <span class="mono">{{ score }} <span class="secondary">[{{ "%+d"|format(character_data.ability.ability_modifiers[ability]) }}]</span></span>
      </div>
      {% endfor %}
    </div>

    <p class="section-label">Skills &middot; (passive) [bonus]</p>
    <div class="row-list">
      {% for skill, data in character_data.ability.skills.items() %}
      <div class="row">
        <span class="{{ 'expertise' if data.expertise else ('accent' if data.proficient else '') }}">
          {{ skill | capitalize }}
          <span class="muted" style="font-size:11px;">{{ ability_abbreviations[skill_abilities[skill]] }}</span>
        </span>
        <span class="mono {{ 'expertise' if data.expertise else ('accent' if data.proficient else '') }}">({{ data.passive_score }}) [{{ "%+d"|format(data.bonus) }}]</span>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- ================= PAGE 2: COMBAT ================= -->
  <section data-page="2">
    <h1 style="font-size:16px;display:block;margin-bottom:12px;">Combat</h1>

    <div class="metric-row">
      <div class="metric">
        <p class="metric-label">Armor class</p>
        <p class="metric-value" style="font-size:22px;">{{ character_data.combat.armor_class }}</p>
      </div>
      <div class="metric-divider"></div>
      <div class="metric">
        <p class="metric-label">Initiative</p>
        <p class="metric-value accent" style="font-size:22px;">[{{ "%+d"|format(character_data.combat.initiative) }}]</p>
      </div>
    </div>

    <p class="section-label">Attacks</p>
    {% for atk in character_data.combat.attacks %}
    <div class="weapon-card">
      <div class="weapon-top">
        <span class="weapon-name">{{ atk.name }}</span>
        <span class="mono">({{ "%+d"|format(atk.to_hit) }}) [{{ "%+d"|format(atk.damage_bonus) }}]</span>
      </div>
      <p class="weapon-sub">
        {{ atk.damage_dice }} {{ atk.damage_type | lower }}{% if atk.range %} &middot; range {{ atk.range.normal }}/{{ atk.range.long }}ft{% endif %}
      </p>
    </div>
    {% else %}
    <p class="empty-state">No weapons equipped.</p>
    {% endfor %}

    <p class="section-label" style="margin-top:4px;">Death saves</p>
    <div class="death-saves">
      <div class="death-row">
        <span class="secondary" style="width:58px;">Success</span>
        <div class="death-dots" id="death-success-dots">
          <span class="death-dot" data-index="0"></span>
          <span class="death-dot" data-index="1"></span>
          <span class="death-dot" data-index="2"></span>
        </div>
        <button class="hp-btn" id="death-success-btn" aria-label="Record a success" style="width:26px;height:26px;font-size:14px;">+</button>
      </div>
      <div class="death-row">
        <span class="secondary" style="width:58px;">Failure</span>
        <div class="death-dots" id="death-failure-dots">
          <span class="death-dot" data-index="0"></span>
          <span class="death-dot" data-index="1"></span>
          <span class="death-dot" data-index="2"></span>
        </div>
        <button class="hp-btn" id="death-failure-btn" aria-label="Record a failure" style="width:26px;height:26px;font-size:14px;">+</button>
      </div>
      <button id="death-reset" aria-label="Reset death saves">Reset</button>
    </div>
  </section>

  <!-- ================= PAGE 3: SPELLS ================= -->
  <section data-page="3">
    <h1 style="font-size:16px;display:block;margin-bottom:12px;">Spells</h1>

    <div class="row-list">
      <div class="row"><span>Spellcasting ability</span><span>{{ character_data.spell.spellcasting_ability | capitalize }}</span></div>
      <div class="row"><span>Save dc</span><span class="mono">{{ character_data.spell.spell_save_dc_value }}</span></div>
      <div class="row"><span>Attack bonus</span><span class="mono accent">[{{ "%+d"|format(character_data.spell.spell_attack_bonus_value) }}]</span></div>
    </div>

    {% set has_slots = character_data.spell.spell_slots.values() | select("greaterthan", 0) | list %}
    <p class="section-label">Spell slots</p>
    {% if has_slots %}
    <div style="margin-bottom:16px;">
      {% for level_key, total in character_data.spell.spell_slots.items() %}
      {% if total > 0 %}
      <div class="slot-counter-row" data-slot-max="{{ total }}">
        <span class="slot-label">Lv{{ level_key.split("_")[1] }}</span>
        <button class="hp-btn slot-minus" aria-label="Use a {{ level_key }} slot" style="width:26px;height:26px;font-size:14px;">&minus;</button>
        <span class="mono slot-current-max"><span class="slot-current">{{ total }}</span> / {{ total }}</span>
        <button class="hp-btn slot-plus" aria-label="Restore a {{ level_key }} slot" style="width:26px;height:26px;font-size:14px;">+</button>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% else %}
    <p class="empty-state">No spell slots.</p>
    {% endif %}

    {% set spells_known = character_data.spell.spell_list | selectattr("name") | list %}
    {% if spells_known %}
      {% for lvl in range(0, 10) %}
        {% set spells_at_level = spells_known | selectattr("level", "equalto", lvl) | list | sort(attribute="name") %}
        {% if spells_at_level %}
        <p class="section-label">{{ "Cantrips" if lvl == 0 else (lvl|string + (["th","st","nd","rd"][lvl] if lvl < 4 else "th") + " level") }}</p>
        <div class="row-list" style="margin-bottom:12px;">
          {% for spell in spells_at_level %}
          <div class="disclosure" data-toggle>
            <div class="disclosure-head">
              <span class="disclosure-title {{ 'prepared' if spell.prepared else 'unprepared' }}">{{ spell.name }}</span>
              <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <div class="disclosure-body">
              {% for para in (spell.description if spell.description else "No description recorded.") | paragraphs %}
              <p>{{ para }}</p>
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      {% endfor %}
    {% else %}
    <p class="empty-state">No spells recorded.</p>
    {% endif %}
  </section>

  <!-- ================= PAGE 4: ITEMS & CURRENCY ================= -->
  <section data-page="4">
    <h1 style="font-size:16px;display:block;margin-bottom:12px;">Items and currency</h1>

    {% set equipped_weapons = character_data.equipment_and_currency.equipment.weapons | selectattr("equipped") | list %}
    {% set equipped_armor = character_data.equipment_and_currency.equipment.armor | selectattr("equipped") | list %}
    <p class="section-label">Equipped</p>
    <div class="row-list">
      {% for w in equipped_weapons %}
      <div class="row"><span>{{ w.name }}</span><span class="secondary">Weapon</span></div>
      {% endfor %}
      {% for a in equipped_armor %}
      <div class="row"><span>{{ a.name }}</span><span class="secondary">{{ a.armor_category | capitalize }}</span></div>
      {% endfor %}
      {% if character_data.equipment_and_currency.equipment.shield %}
      <div class="row"><span>Shield</span><span class="secondary">+2 ac</span></div>
      {% endif %}
      {% if not equipped_weapons and not equipped_armor and not character_data.equipment_and_currency.equipment.shield %}
      <p class="empty-state">Nothing equipped.</p>
      {% endif %}
    </div>

    {% set unequipped_weapons = character_data.equipment_and_currency.equipment.weapons | rejectattr("equipped") | list %}
    {% set unequipped_armor = character_data.equipment_and_currency.equipment.armor | rejectattr("equipped") | list %}
    {% set tools = character_data.equipment_and_currency.equipment.tools | selectattr("name") | list %}
    {% set other = character_data.equipment_and_currency.equipment.other | selectattr("name") | list %}

    <p class="section-label">Currency</p>
    <div class="row-list">
      <div class="row"><span class="secondary">Platinum</span><span class="mono">{{ character_data.equipment_and_currency.currency.platinum }}</span></div>
      <div class="row"><span class="secondary">Gold</span><span class="mono">{{ character_data.equipment_and_currency.currency.gold }}</span></div>
      <div class="row"><span class="secondary">Electrum</span><span class="mono">{{ character_data.equipment_and_currency.currency.electrum }}</span></div>
      <div class="row"><span class="secondary">Silver</span><span class="mono">{{ character_data.equipment_and_currency.currency.silver }}</span></div>
      <div class="row"><span class="secondary">Copper</span><span class="mono">{{ character_data.equipment_and_currency.currency.copper }}</span></div>
    </div>

    <p class="section-label">Inventory</p>
    <div class="row-list">
      {% for w in unequipped_weapons %}
      <div class="disclosure" data-toggle>
        <div class="disclosure-head">
          <span class="disclosure-title">{{ w.name }}</span>
          <span style="display:flex;align-items:center;gap:8px;">
            <span class="secondary" style="font-size:12px;">Weapon</span>
            <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </div>
        <p class="disclosure-body">{{ w.damage_dice }} {{ w.damage_type | lower }}{% if w.range %} &middot; range {{ w.range.normal }}/{{ w.range.long }}ft{% endif %}</p>
      </div>
      {% endfor %}
      {% for a in unequipped_armor %}
      <div class="disclosure" data-toggle>
        <div class="disclosure-head">
          <span class="disclosure-title">{{ a.name }}</span>
          <span style="display:flex;align-items:center;gap:8px;">
            <span class="secondary" style="font-size:12px;">Armor</span>
            <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </div>
        <p class="disclosure-body">Base ac {{ a.armor_base }} &middot; {{ a.armor_category | capitalize }}</p>
      </div>
      {% endfor %}
      {% for t in tools %}
      <div class="disclosure" data-toggle>
        <div class="disclosure-head">
          <span class="disclosure-title">{{ t.name }}</span>
          <span style="display:flex;align-items:center;gap:8px;">
            <span class="secondary" style="font-size:12px;">Tool</span>
            <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </div>
        <div class="disclosure-body">
          {% for para in (t.description if t.description else "No description recorded.") | paragraphs %}
          <p>{{ para }}</p>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      {% for o in other %}
      <div class="disclosure" data-toggle>
        <div class="disclosure-head">
          <span class="disclosure-title">{{ o.name }}{% if o.quantity and o.quantity > 1 %} ({{ o.quantity }}){% endif %}</span>
          <span style="display:flex;align-items:center;gap:8px;">
            <span class="secondary" style="font-size:12px;">Item</span>
            <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </div>
        <div class="disclosure-body">
          {% for para in (o.description if o.description else "No description recorded.") | paragraphs %}
          <p>{{ para }}</p>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      {% if not unequipped_weapons and not unequipped_armor and not tools and not other %}
      <p class="empty-state">Nothing in inventory.</p>
      {% endif %}
    </div>
  </section>

  <!-- ================= BOTTOM NAV ================= -->
  <nav>
    <button class="nav-btn active" data-nav="0" aria-label="Overview">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"></path></svg>
      <span class="nav-dot"></span>
    </button>
    <button class="nav-btn" data-nav="1" aria-label="Abilities and skills">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="20" x2="6" y2="12"></line><line x1="12" y1="20" x2="12" y2="6"></line><line x1="18" y1="20" x2="18" y2="15"></line></svg>
      <span class="nav-dot"></span>
    </button>
    <button class="nav-btn" data-nav="2" aria-label="Combat">
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <g transform="rotate(45 12 12)">
          <path d="M12 1.8 L13.6 12.5 L12 14.4 L10.4 12.5 Z"></path>
          <rect x="7.8" y="13.4" width="8.4" height="2" rx="1"></rect>
          <rect x="10.6" y="15.6" width="2.8" height="5.4" rx="1.2"></rect>
          <circle cx="12" cy="21.4" r="1.4"></circle>
        </g>
      </svg>
      <span class="nav-dot"></span>
    </button>
    <button class="nav-btn" data-nav="3" aria-label="Spells">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l1.6 4.4L18 10l-4.4 1.6L12 16l-1.6-4.4L6 10l4.4-1.6z"></path><path d="M18.5 15.5l0.7 1.8 1.8 0.7-1.8 0.7-0.7 1.8-0.7-1.8-1.8-0.7 1.8-0.7z"></path></svg>
      <span class="nav-dot"></span>
    </button>
    <button class="nav-btn" data-nav="4" aria-label="Items and currency">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7V6a3 3 0 0 1 6 0v1"></path><path d="M6 9a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"></path><path d="M9.5 12.5h5"></path><path d="M9.5 15.5h5"></path></svg>
      <span class="nav-dot"></span>
    </button>
  </nav>

</div>

<script>
(function () {
  // ---- page navigation ----
  var sections = document.querySelectorAll("section[data-page]");
  var navBtns = document.querySelectorAll(".nav-btn");
  function showPage(i) {
    sections.forEach(function (s) { s.classList.toggle("active", s.dataset.page === String(i)); });
    navBtns.forEach(function (b) { b.classList.toggle("active", b.dataset.nav === String(i)); });
  }
  navBtns.forEach(function (b) { b.addEventListener("click", function () { showPage(b.dataset.nav); }); });
  showPage(0);

  // ---- current hp (live, non-persistent) ----
  var hpMax = {{ character_data.combat.hp.maximum_hp }};
  var hp = hpMax;
  var hpVal = document.getElementById("hp-val");
  var hpBar = document.getElementById("hp-bar");
  function updateHp() {
    hpVal.textContent = hp;
    hpBar.style.width = Math.max(0, Math.round((hp / hpMax) * 100)) + "%";
  }
  document.getElementById("hp-minus").addEventListener("click", function () { hp = Math.max(0, hp - 1); updateHp(); });
  document.getElementById("hp-plus").addEventListener("click", function () { hp = Math.min(hpMax, hp + 1); updateHp(); });

  // ---- feature / trait / spell / item disclosures (only one open at a time) ----
  var openDisclosure = null;
  document.querySelectorAll("[data-toggle]").forEach(function (el) {
    el.addEventListener("click", function () {
      if (openDisclosure && openDisclosure !== el) {
        openDisclosure.classList.remove("open");
      }
      el.classList.toggle("open");
      openDisclosure = el.classList.contains("open") ? el : null;
    });
  });

  // ---- spell slots (live, non-persistent, clamped 0 to max — same pattern as hp) ----
  document.querySelectorAll(".slot-counter-row").forEach(function (row) {
    var max = parseInt(row.dataset.slotMax, 10);
    var current = max;
    var currentEl = row.querySelector(".slot-current");
    row.querySelector(".slot-minus").addEventListener("click", function () {
      current = Math.max(0, current - 1);
      currentEl.textContent = current;
    });
    row.querySelector(".slot-plus").addEventListener("click", function () {
      current = Math.min(max, current + 1);
      currentEl.textContent = current;
    });
  });

  // ---- death saves (live, non-persistent) ----
  var deathState = { success: 0, failure: 0 };
  function renderDeathSaves() {
    document.querySelectorAll("#death-success-dots .death-dot").forEach(function (dot, i) {
      dot.classList.toggle("filled-success", i < deathState.success);
    });
    document.querySelectorAll("#death-failure-dots .death-dot").forEach(function (dot, i) {
      dot.classList.toggle("filled-failure", i < deathState.failure);
    });
  }
  document.getElementById("death-success-btn").addEventListener("click", function () {
    deathState.success = Math.min(3, deathState.success + 1);
    renderDeathSaves();
  });
  document.getElementById("death-failure-btn").addEventListener("click", function () {
    deathState.failure = Math.min(3, deathState.failure + 1);
    renderDeathSaves();
  });
  document.getElementById("death-reset").addEventListener("click", function () {
    deathState.success = 0;
    deathState.failure = 0;
    renderDeathSaves();
  });
  renderDeathSaves();
})();
</script>

</body>
</html>
